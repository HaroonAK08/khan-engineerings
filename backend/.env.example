PORT=5000

# Local testing (default)
MONGODB_URI=mongodb://127.0.0.1:27017/khan-engineerings

# Production Atlas (use on Vercel / .env.production — never commit real credentials)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/khan-engineerings?retryWrites=true&w=majority

JWT_SECRET=change-me
NODE_ENV=development
# Comma-separated list of allowed frontend origins (exact match, including port)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://169.58.77.237:3000
# COOKIE_DOMAIN=.yourdomain.com
# Set COOKIE_INSECURE=true for HTTP (non-HTTPS) hosts so auth cookies can be set
# COOKIE_INSECURE=true

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@khanengineerings.com
ADMIN_PASSWORD=admin123
APP_PIN=3811
